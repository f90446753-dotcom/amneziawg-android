<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="org.amnezia.awg.model.ObservableTunnel" />

        <variable
            name="fragment"
            type="org.amnezia.awg.fragment.TunnelListFragment" />

        <variable
            name="rowConfigurationHandler"
            type="org.amnezia.awg.databinding.ObservableKeyedRecyclerViewAdapter.RowConfigurationHandler" />

        <variable
            name="tunnels"
            type="org.amnezia.awg.databinding.ObservableKeyedArrayList&lt;String, ObservableTunnel&gt;" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Hero card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_hero_gradient"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-60dp"
                    android:layout_marginEnd="-50dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_hero_decor" />

                <org.amnezia.awg.widget.HeroStatusView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp"
                    app:tunnels="@{tunnels}">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/hero_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_hero_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="@string/awg_hero_badge"
                            android:textColor="@color/awg_hero_on"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/hero_ping"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_hero_pill"
                            android:clickable="true"
                            android:contentDescription="@string/awg_ping_start_desc"
                            android:focusable="true"
                            android:padding="9dp"
                            android:src="@drawable/ic_ping_bolt" />

                        <ImageView
                            android:id="@+id/hero_shield"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_hero_shield" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/hero_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-24dp"
                        android:layout_marginTop="-4dp"
                        android:layout_marginEnd="-24dp"
                        android:layout_marginBottom="-24dp"
                        android:ellipsize="end"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="24dp"
                        android:maxLines="1"
                        android:text="@string/awg_hero_title"
                        android:textAppearance="@style/TextAppearance.Awg.HeroTitle" />

                    <TextView
                        android:id="@+id/hero_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@{@plurals/awg_tunnel_count(tunnels.size(), tunnels.size())}"
                        android:textAppearance="@style/TextAppearance.Awg.HeroSub"
                        tools:text="3 tunnels" />

                </org.amnezia.awg.widget.HeroStatusView>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="26dp"
                android:layout_marginBottom="4dp"
                android:text="@string/awg_section_tunnels"
                android:textAppearance="@style/TextAppearance.Awg.Section"
                android:visibility="@{tunnels.size() > 0 ? android.view.View.VISIBLE : android.view.View.GONE}" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tunnel_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:nextFocusDown="@id/create_fab"
                    android:nextFocusForward="@id/create_fab"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="104dp"
                    android:visibility="@{tunnels.size() > 0 ? android.view.View.VISIBLE : android.view.View.GONE}"
                    app:configurationHandler="@{rowConfigurationHandler}"
                    app:items="@{tunnels}"
                    app:layout="@{@layout/tunnel_list_item}"
                    tools:itemCount="3"
                    tools:listitem="@layout/tunnel_list_item" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="80dp"
                    android:visibility="@{tunnels.size() == 0 ? android.view.View.VISIBLE : android.view.View.GONE}"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="132dp"
                        android:layout_height="132dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_empty_state" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/awg_empty_title"
                        android:textAppearance="@style/TextAppearance.Awg.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/tunnel_list_placeholder_margin"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="@dimen/tunnel_list_placeholder_margin"
                        android:gravity="center"
                        android:text="@string/awg_empty_body"
                        android:textAppearance="@style/TextAppearance.Awg.Body" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/create_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/fab_margin"
            android:nextFocusUp="@id/tunnel_list"
            android:text="@string/awg_add_tunnel"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:icon="@drawable/ic_action_add_white"
            app:iconTint="?attr/colorOnPrimary"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Awg.Pill" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
