<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="org.amnezia.awg.backend.Tunnel.State" />

        <import type="org.amnezia.awg.model.ObservableTunnel.ConnectionStatus" />

        <import type="org.amnezia.awg.util.ClipboardUtils" />

        <variable
            name="fragment"
            type="org.amnezia.awg.fragment.TunnelDetailFragment" />

        <variable
            name="tunnel"
            type="org.amnezia.awg.model.ObservableTunnel" />

        <variable
            name="config"
            type="org.amnezia.awg.config.Config" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:clipToPadding="false"
        android:focusable="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp">

            <!-- Hero: tunnel name, live status and the main switch -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_gradient"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-60dp"
                    android:layout_marginEnd="-50dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_hero_decor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/interface_name_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_hero_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="@{tunnel.connectionStatus == ConnectionStatus.CONNECTED ? @string/tunnel_status_connected : (tunnel.connectionStatus == ConnectionStatus.CONNECTING ? @string/tunnel_status_connecting : @string/awg_status_off)}"
                            android:textColor="@color/awg_hero_on"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Connected" />

                        <TextView
                            android:id="@+id/interface_name_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:contentDescription="@string/name"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:onClick="@{ClipboardUtils::copyTextView}"
                            android:text="@{tunnel.name}"
                            android:textAppearance="@style/TextAppearance.Awg.HeroTitle"
                            tools:text="awg0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/awg_detail_copy_hint"
                            android:textAppearance="@style/TextAppearance.Awg.HeroSub" />
                    </LinearLayout>

                    <org.amnezia.awg.widget.ToggleSwitch
                        android:id="@+id/tunnel_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_hero_pill"
                        android:nextFocusDown="@id/public_key_text"
                        android:nextFocusForward="@id/public_key_text"
                        android:padding="10dp"
                        android:theme="@style/ThemeOverlay.Awg.OnHero"
                        app:checked="@{tunnel.state == State.UP}"
                        app:onBeforeCheckedChanged="@{fragment::setTunnelState}" />
                </LinearLayout>
            </FrameLayout>

            <!-- Connection -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tunnel_detail_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/interface_title"
                        style="@style/Awg.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/awg_detail_connection" />

                    <TextView android:id="@+id/public_key_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/public_key" />
                    <TextView android:id="@+id/public_key_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/public_key" android:ellipsize="end" android:maxLines="1" android:onClick="@{ClipboardUtils::copyTextView}" android:singleLine="true" android:text="@{config.interface.keyPair.publicKey.toBase64}" tools:text="wOs2eguFEohqIZxlSJ1CAT9584tc6ejj9hfGFsoBVkA="/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{config.interface.addresses.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/addresses_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/addresses" />
                    <TextView android:id="@+id/addresses_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/addresses" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.addresses}" tools:text="fc00:bbbb:bbbb:bb11::3:368b/128"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{config.interface.dnsServers.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/dns_servers_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dns_servers" />
                    <TextView android:id="@+id/dns_servers_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/dns_servers" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.dnsServers}" tools:text="8.8.8.8, 8.8.4.4"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{config.interface.dnsSearchDomains.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/dns_search_domains_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dns_search_domains" />
                    <TextView android:id="@+id/dns_search_domains_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/dns_search_domains" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.dnsSearchDomains}" tools:text="zx2c4.com"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.listenPort.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/listen_port_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/listen_port" />
                    <TextView android:id="@+id/listen_port_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/listen_port" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.listenPort}" tools:text="51820"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.mtu.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/mtu_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mtu" />
                    <TextView android:id="@+id/mtu_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/mtu" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.mtu}" tools:text="1500"/>
                    </LinearLayout>

                <TextView
                    android:id="@+id/applications_label"
                    style="@style/Awg.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/applications"
                    android:visibility="@{config.interface.includedApplications.isEmpty() &amp;&amp; config.interface.excludedApplications.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}" />

                <TextView
                    android:id="@+id/applications_text"
                    style="@style/Awg.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/applications"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:text="@{config.interface.includedApplications.isEmpty() ? @plurals/n_excluded_applications(config.interface.excludedApplications.size(), config.interface.excludedApplications.size()) : @plurals/n_included_applications(config.interface.includedApplications.size(), config.interface.includedApplications.size())}"
                    android:visibility="@{config.interface.includedApplications.isEmpty() &amp;&amp; config.interface.excludedApplications.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}"
                    tools:text="8 excluded" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Obfuscation + advanced -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tunnel_obfuscation_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="@{config.interface.junkPacketCount.isPresent() || config.interface.initPacketMagicHeader.isPresent() || config.interface.specialJunkI1.isPresent() || config.interface.headerProtectionKey.isPresent() || config.interface.contentPaddingAddition.isPresent() || config.interface.rekeyAfterTime.isPresent() || config.interface.keepaliveTimeout.isPresent() || config.interface.randomTrailers.isPresent() || config.interface.disableCookies.isPresent() ? android.view.View.VISIBLE : android.view.View.GONE}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/obfuscation_title"
                        style="@style/Awg.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/awg_detail_obfuscation"
                        android:visibility="@{config.interface.junkPacketCount.isPresent() || config.interface.initPacketMagicHeader.isPresent() || config.interface.specialJunkI1.isPresent() ? android.view.View.VISIBLE : android.view.View.GONE}" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.junkPacketCount.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/junk_packet_count_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/junk_packet_count" />
                    <TextView android:id="@+id/junk_packet_count_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.junkPacketCount}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/junk_packet_count" tools:text="3"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.junkPacketMinSize.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/junk_packet_min_size_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/junk_packet_min_size" />
                    <TextView android:id="@+id/junk_packet_min_size_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.junkPacketMinSize}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/junk_packet_min_size" tools:text="10"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.junkPacketMaxSize.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/junk_packet_max_size_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/junk_packet_max_size" />
                    <TextView android:id="@+id/junk_packet_max_size_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.junkPacketMaxSize}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/junk_packet_max_size" tools:text="30"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.initPacketJunkSize.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/init_packet_junk_size_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/init_packet_junk_size" />
                    <TextView android:id="@+id/init_packet_junk_size_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.initPacketJunkSize}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/init_packet_junk_size" tools:text="15"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.responsePacketJunkSize.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/response_packet_junk_size_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/response_packet_junk_size" />
                    <TextView android:id="@+id/response_packet_junk_size_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.responsePacketJunkSize}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/response_packet_junk_size" tools:text="18"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.cookieReplyPacketJunkSize.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/cookie_reply_packet_junk_size_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cookie_reply_packet_junk_size" />
                    <TextView android:id="@+id/cookie_reply_packet_junk_size_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.cookieReplyPacketJunkSize}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/cookie_reply_packet_junk_size" tools:text="20"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.transportPacketJunkSize.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/transport_packet_junk_size_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transport_packet_junk_size" />
                    <TextView android:id="@+id/transport_packet_junk_size_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.transportPacketJunkSize}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/transport_packet_junk_size" tools:text="22"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.initPacketMagicHeader.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/init_packet_magic_header_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/init_packet_magic_header" />
                    <TextView android:id="@+id/init_packet_magic_header_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.initPacketMagicHeader}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/init_packet_magic_header" tools:text="1020325451"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.responsePacketMagicHeader.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/response_packet_magic_header_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/response_packet_magic_header" />
                    <TextView android:id="@+id/response_packet_magic_header_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.responsePacketMagicHeader}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/response_packet_magic_header" tools:text="3288052141"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.underloadPacketMagicHeader.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/underload_packet_magic_header_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/underload_packet_magic_header" />
                    <TextView android:id="@+id/underload_packet_magic_header_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.underloadPacketMagicHeader}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/underload_packet_magic_header" tools:text="2528465083"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.transportPacketMagicHeader.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/transport_packet_magic_header_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transport_packet_magic_header" />
                    <TextView android:id="@+id/transport_packet_magic_header_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@{config.interface.transportPacketMagicHeader}" android:onClick="@{ClipboardUtils::copyTextView}" android:contentDescription="@string/transport_packet_magic_header" tools:text="1766607858"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.specialJunkI1.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/special_junk_i1_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/special_junk_i1" />
                    <TextView android:id="@+id/special_junk_i1_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/special_junk_i1" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.specialJunkI1}"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.specialJunkI2.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/special_junk_i2_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/special_junk_i2" />
                    <TextView android:id="@+id/special_junk_i2_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/special_junk_i2" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.specialJunkI2}" tools:text="&lt;b 0x1234&gt;"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.specialJunkI3.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/special_junk_i3_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/special_junk_i3" />
                    <TextView android:id="@+id/special_junk_i3_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/special_junk_i3" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.specialJunkI3}" tools:text="&lt;b 0x1234567890&gt;"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.specialJunkI4.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/special_junk_i4_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/special_junk_i4" />
                    <TextView android:id="@+id/special_junk_i4_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/special_junk_i4" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.specialJunkI4}" tools:text="&lt;b 0xdeadbeef&gt;"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.specialJunkI5.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/special_junk_i5_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/special_junk_i5" />
                    <TextView android:id="@+id/special_junk_i5_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/special_junk_i5" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.specialJunkI5}" tools:text="&lt;rc 12&gt;&lt;t&gt;&lt;rd 18&gt;"/>
                    </LinearLayout>

                <TextView
                    android:id="@+id/advanced_title"
                    style="@style/Awg.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="22dp"
                    android:text="@string/awg_detail_advanced"
                    android:visibility="@{config.interface.headerProtectionKey.isPresent() || config.interface.contentPaddingAddition.isPresent() || config.interface.rekeyAfterTime.isPresent() || config.interface.keepaliveTimeout.isPresent() || config.interface.randomTrailers.isPresent() || config.interface.disableCookies.isPresent() ? android.view.View.VISIBLE : android.view.View.GONE}" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!config.interface.headerProtectionKey.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/header_protection_key_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/header_protection_key" />
                    <TextView android:id="@+id/header_protection_key_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/header_protection_key" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{config.interface.headerProtectionKey.isPresent() ? config.interface.headerProtectionKey.get().toBase64() : ``}" tools:text="base64key="/>
                    </LinearLayout>

