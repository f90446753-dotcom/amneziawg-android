<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
            <import type="org.amnezia.awg.util.ClipboardUtils"/>
            <variable name="item" type="org.amnezia.awg.config.Peer"/>
        </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/peer_title"
                style="@style/Awg.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/peer" />

                <TextView android:id="@+id/public_key_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/public_key"  />
                <TextView android:id="@+id/public_key_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/public_key" android:ellipsize="end" android:maxLines="1" android:onClick="@{ClipboardUtils::copyTextView}" android:singleLine="true" android:text="@{item.publicKey.toBase64}" tools:text="wOs2eguFEohqIZxlSJ1CAT9584tc6ejj9hfGFsoBVkA=" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!item.preSharedKey.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/pre_shared_key_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pre_shared_key" />
                    <TextView android:id="@+id/pre_shared_key_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/pre_shared_key" android:ellipsize="end" android:maxLines="1" android:singleLine="true" android:text="@string/pre_shared_key_enabled" android:onClick="@{ClipboardUtils::copyTextView}" tools:text="8VyS8W8XeMcBWfKp1GuG3/fZlnUQFkqMNbrdmZtVQIM=" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{item.allowedIps.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/allowed_ips_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/allowed_ips" />
                    <TextView android:id="@+id/allowed_ips_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/allowed_ips" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{item.allowedIps}" tools:text="0.0.0.0/5, 8.0.0.0/7, 11.0.0.0/8, 12.0.0.0/6, 16.0.0.0/4, 32.0.0.0/3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!item.endpoint.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/endpoint_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/endpoint" />
                    <TextView android:id="@+id/endpoint_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/endpoint" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{item.endpoint}" tools:text="192.168.0.1:51820" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="@{!item.persistentKeepalive.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">
                    <TextView android:id="@+id/persistent_keepalive_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/persistent_keepalive" />
                    <TextView android:id="@+id/persistent_keepalive_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/persistent_keepalive" android:onClick="@{ClipboardUtils::copyTextView}" android:text="@{item.persistentKeepalive}" tools:text="every 3 seconds" />
                </LinearLayout>

                <TextView android:id="@+id/transfer_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transfer" android:visibility="gone" tools:visibility="visible" />
                <TextView android:id="@+id/transfer_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/transfer" android:onClick="@{ClipboardUtils::copyTextView}" android:visibility="gone" tools:text="1024 MB" tools:visibility="visible" />

                <TextView android:id="@+id/latest_handshake_label" style="@style/Awg.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/latest_handshake" android:visibility="gone" tools:visibility="visible" />
                <TextView android:id="@+id/latest_handshake_text" style="@style/Awg.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/latest_handshake" android:onClick="@{ClipboardUtils::copyTextView}" android:visibility="gone" tools:text="4 minutes, 27 seconds ago" tools:visibility="visible" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
