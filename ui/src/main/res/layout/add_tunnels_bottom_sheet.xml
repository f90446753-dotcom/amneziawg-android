<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="@dimen/bottom_sheet_top_padding"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:alpha="0.5"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:text="@string/awg_sheet_title"
        android:textAppearance="@style/TextAppearance.Awg.Title" />

    <LinearLayout
        android:id="@+id/create_from_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/list_item_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/bottom_sheet_item_height"
        android:nextFocusDown="@id/create_from_qrcode"
        android:nextFocusForward="@id/create_from_qrcode"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_action_open"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_from_file"
                android:textAppearance="@style/TextAppearance.Awg.ItemTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/awg_sheet_file_sub"
                android:textAppearance="@style/TextAppearance.Awg.ItemSub" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/create_from_qrcode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/list_item_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/bottom_sheet_item_height"
        android:nextFocusUp="@id/create_from_file"
        android:nextFocusDown="@id/create_empty"
        android:nextFocusForward="@id/create_empty"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_action_scan_qr_code"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_from_qr_code"
                android:textAppearance="@style/TextAppearance.Awg.ItemTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/awg_sheet_qr_sub"
                android:textAppearance="@style/TextAppearance.Awg.ItemSub" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/create_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/list_item_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/bottom_sheet_item_height"
        android:nextFocusUp="@id/create_from_qrcode"
        android:nextFocusDown="@id/disclaimer"
        android:nextFocusForward="@id/disclaimer"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_action_edit"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_empty"
                android:textAppearance="@style/TextAppearance.Awg.ItemTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/awg_sheet_empty_sub"
                android:textAppearance="@style/TextAppearance.Awg.ItemSub" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/disclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="4dp"
        android:focusable="true"
        android:linksClickable="true"
        android:nextFocusUp="@id/create_empty"
        android:text="@string/import_disclaimer"
        android:textAppearance="@style/TextAppearance.Awg.ItemSub"
        android:textColorLink="?attr/colorPrimary" />

</LinearLayout>
