<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
            <import type="org.amnezia.awg.util.ClipboardUtils"/>
            <import type="org.amnezia.awg.widget.KeyInputFilter"/>
            <import type="org.amnezia.awg.widget.NameInputFilter"/>
            <variable name="fragment" type="org.amnezia.awg.fragment.TunnelEditorFragment"/>
            <variable name="config" type="org.amnezia.awg.viewmodel.ConfigProxy"/>
            <variable name="name" type="String"/>
        </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="@string/awg_editor_heading"
                    android:textAppearance="@style/TextAppearance.Awg.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:text="@string/awg_editor_sub"
                    android:textAppearance="@style/TextAppearance.Awg.Body" />

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:id="@+id/interface_title" android:text="@string/awg_editor_interface" style="@style/Awg.Section" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/interface_name_layout" android:hint="@string/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/interface_name_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions|textVisiblePassword" android:text="@={name}" app:filter="@{NameInputFilter.newInstance()}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/private_key_text_layout" android:hint="@string/private_key" app:endIconContentDescription="@string/generate_new_private_key" app:endIconDrawable="@drawable/ic_action_generate" app:endIconMode="custom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/private_key_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions|textPassword" android:onClick="@{fragment::onKeyClick}" android:text="@={config.interface.privateKey}" app:filter="@{KeyInputFilter.newInstance()}" app:onFocusChange="@{fragment::onKeyFocusChange}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/public_key_label_layout" android:hint="@string/public_key" app:expandedHintEnabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/public_key_text" android:editable="false" android:ellipsize="end" android:focusable="false" android:hint="@string/hint_generated" android:imeOptions="actionNext" android:onClick="@{ClipboardUtils::copyTextView}" android:singleLine="true" android:text="@{config.interface.publicKey}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/addresses_label_layout" android:hint="@string/addresses" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/addresses_label_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions|textVisiblePassword" android:text="@={config.interface.addresses}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/listen_port_label_layout" android:hint="@string/listen_port" app:expandedHintEnabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/listen_port_text" android:hint="@string/hint_random" android:imeOptions="actionNext" android:inputType="number" android:text="@={config.interface.listenPort}" android:textAlignment="center" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/dns_servers_label_layout" android:hint="@string/dns_servers" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/dns_servers_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions|textVisiblePassword" android:text="@={config.interface.dnsServers}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/mtu_label_layout" android:hint="@string/mtu" app:expandedHintEnabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/mtu_text" android:hint="@string/hint_automatic" android:imeOptions="actionNext" android:inputType="number" android:text="@={config.interface.mtu}" android:textAlignment="center" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:text="@string/awg_detail_obfuscation" style="@style/Awg.Section" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/junk_packet_count_layout" android:hint="@string/junk_packet_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/junk_packet_count_text" android:imeOptions="actionNext" android:inputType="number" android:text="@={config.interface.junkPacketCount}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/junk_packet_min_size_layout" android:hint="@string/junk_packet_min_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/junk_packet_min_size_text" android:imeOptions="actionNext" android:inputType="number" android:text="@={config.interface.junkPacketMinSize}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/junk_packet_max_size_layout" android:hint="@string/junk_packet_max_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/junk_packet_max_size_text" android:imeOptions="actionNext" android:inputType="number" android:text="@={config.interface.junkPacketMaxSize}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/init_packet_junk_size_layout" android:hint="@string/init_packet_junk_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/init_packet_junk_size_text" android:imeOptions="actionNext" android:inputType="number" android:text="@={config.interface.initPacketJunkSize}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/response_packet_junk_size_layout" android:hint="@string/response_packet_junk_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/response_packet_junk_size_text" android:imeOptions="actionNext" android:inputType="number" android:text="@={config.interface.responsePacketJunkSize}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/cookie_reply_packet_junk_size_layout" android:hint="@string/cookie_reply_packet_junk_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/cookie_reply_packet_junk_size_text" android:imeOptions="actionNext" android:inputType="number" android:text="@={config.interface.cookieReplyPacketJunkSize}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/transport_packet_junk_size_layout" android:hint="@string/transport_packet_junk_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/transport_packet_junk_size_text" android:imeOptions="actionNext" android:inputType="number" android:text="@={config.interface.transportPacketJunkSize}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/init_packet_magic_header_layout" android:hint="@string/init_packet_magic_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/init_packet_magic_header_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.initPacketMagicHeader}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/response_packet_magic_header_layout" android:hint="@string/response_packet_magic_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/response_packet_magic_header_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.responsePacketMagicHeader}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/underload_packet_magic_header_layout" android:hint="@string/underload_packet_magic_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/underload_packet_magic_header_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.underloadPacketMagicHeader}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/transport_packet_magic_header_layout" android:hint="@string/transport_packet_magic_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/transport_packet_magic_header_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.transportPacketMagicHeader}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:text="@string/awg_editor_special" style="@style/Awg.Section" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/special_junk_i1_layout" android:hint="@string/special_junk_i1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/special_junk_i1_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.specialJunkI1}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/special_junk_i2_layout" android:hint="@string/special_junk_i2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/special_junk_i2_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.specialJunkI2}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/special_junk_i3_layout" android:hint="@string/special_junk_i3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/special_junk_i3_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.specialJunkI3}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/special_junk_i4_layout" android:hint="@string/special_junk_i4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/special_junk_i4_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.specialJunkI4}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/special_junk_i5_layout" android:hint="@string/special_junk_i5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/special_junk_i5_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.specialJunkI5}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:text="@string/awg_detail_advanced" style="@style/Awg.Section" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/header_protection_key_layout" android:hint="@string/header_protection_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/header_protection_key_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.headerProtectionKey}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/content_padding_addition_layout" android:hint="@string/content_padding_addition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/content_padding_addition_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.contentPaddingAddition}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/rekey_after_time_layout" android:hint="@string/rekey_after_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/rekey_after_time_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.rekeyAfterTime}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/rekey_timeout_layout" android:hint="@string/rekey_timeout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/rekey_timeout_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.rekeyTimeout}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/reject_after_time_layout" android:hint="@string/reject_after_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/reject_after_time_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.rejectAfterTime}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/keepalive_timeout_layout" android:hint="@string/keepalive_timeout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/keepalive_timeout_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.keepaliveTimeout}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/max_handshake_attempts_layout" android:hint="@string/max_handshake_attempts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/max_handshake_attempts_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.maxHandshakeAttempts}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/random_trailers_layout" android:hint="@string/random_trailers" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/random_trailers_text" android:imeOptions="actionNext" android:inputType="textNoSuggestions" android:text="@={config.interface.randomTrailers}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/disable_cookies_layout" android:hint="@string/disable_cookies" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/disable_cookies_text" android:imeOptions="actionDone" android:inputType="textNoSuggestions" android:text="@={config.interface.disableCookies}" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/set_excluded_applications"
                    style="@style/Widget.Awg.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:onClick="@{fragment::onRequestSetExcludedIncludedApplications}"
                    android:text="@{config.interface.includedApplications.size &gt; 0 ? @plurals/set_included_applications(config.interface.includedApplications.size, config.interface.includedApplications.size) : config.interface.excludedApplications.size &gt; 0 ? @plurals/set_excluded_applications(config.interface.excludedApplications.size, config.interface.excludedApplications.size) : @string/all_applications}" />

                <LinearLayout
                    android:id="@+id/peers_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:fragment="@{fragment}"
                    app:items="@{config.peers}"
                    app:layout="@{@layout/tunnel_editor_peer}" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_peer_button"
                    style="@style/Widget.Awg.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:onClick="@{() -&gt; config.addPeer()}"
                    android:text="@string/add_peer" />
            </LinearLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
