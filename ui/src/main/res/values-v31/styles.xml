<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the app behind a bottom sheet is really blurred. -->
    <style name="AmneziaWgTheme.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/Widget.Awg.BottomSheet</item>
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">32dp</item>
    </style>
</resources>
